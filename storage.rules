rules_version = '2';

// Firebase Storage security rules for rent-control.
//
// Uploads happen directly from the browser (see src/shared/utils/firebaseUpload.ts)
// to the path:  {entityType}/{ownerId}/{uuid}/{filename}
// where ownerId is the uploader's Firebase Auth UID and entityType is one of
// properties | renters | transactions.
//
// These rules are the ONLY thing protecting the bucket from an authenticated
// user reading or overwriting other users' files, so keep them tight.
//
// NOTE: The backend uses the Admin SDK (service account) for cleanup, which
// bypasses these rules entirely. Both apps read files through the SDK
// (src/shared/utils/storedFile.ts here and in the mobile repo), so the read rule
// below is what protects them there. The stored values are still tokenized download URLs, which bypass read
// rules for anyone holding one — retiring them is tracked in PLATFORM.md §18.
//
// SDK reads from a browser need the bucket's CORS config, kept in storage.cors.json
// (the same origins as the backend's CORS_ORIGINS). Apply it with:
//   gsutil cors set storage.cors.json gs://rent-control-5c5da.firebasestorage.app
//
// To deploy:  firebase deploy --only storage   (or paste into the console).

service firebase.storage {
  match /b/{bucket}/o {

    // A signed-in user owns the path segment matching their UID.
    function isOwner(ownerId) {
      return request.auth != null && request.auth.uid == ownerId;
    }

    // Allowed upload types: images, PDFs, and Word documents.
    // Mirror src/shared/utils/firebaseUpload.ts isAllowedType().
    function isAllowedType() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';
    }

    // Cap uploads at 10 MB.
    function isUnderSizeLimit() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // Per-user, per-entity uploads.
    match /{entityType}/{ownerId}/{allPaths=**} {
      allow read: if isOwner(ownerId);
      allow write: if isOwner(ownerId)
                   && entityType in ['properties', 'renters', 'transactions']
                   && isAllowedType()
                   && isUnderSizeLimit();
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
