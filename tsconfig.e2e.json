{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    /* DOM because specs run code inside the browser via page.evaluate(). */
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Same alias as the app. A spec that imports app source (rather than driving it through
       a browser) pulls that module's own "@/..." imports in with it, and the checker has to
       resolve them the way Playwright already does at runtime. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["playwright.config.ts", "e2e"]
}
