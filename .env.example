VITE_API_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Guided onboarding tours. `on` / `off`. Unset means on under `npm run dev` and off in
# every build, which is what keeps the half-finished tour content out of production.
# A per-browser override beats this: run `rentvanceTours(true)` in the console.
VITE_ONBOARDING_TOURS=

# Optional: Sentry error monitoring. Leave blank to disable. Only used in prod builds.
VITE_SENTRY_DSN=

# Optional: the Sentry `environment` tag, which is what lets an alert rule fire on
# production only. Normally leave unset — the Dockerfile falls back to Railway's
# injected environment name, and then to `production`. Set it only to override.
VITE_SENTRY_ENVIRONMENT=

# Build-time only (source-map upload to Sentry). Not inlined into the bundle. Leave
# blank locally and in CI — the plugin is skipped and no source maps are emitted.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Paddle client-side token (live_... or test_...) for /pay, Paddle's default payment link.
# Public by design - it ships in the bundle. Never the Paddle API key. Empty = /pay says
# checkout is unavailable instead of failing silently.
VITE_PADDLE_CLIENT_TOKEN=

# RevenueCat *public* key of the Paddle app (Project settings -> API keys). Opens the
# in-app checkout on /plans. Public by design; never a secret key (sk_...). Empty = the
# plan picker shows its buy buttons disabled.
VITE_REVENUECAT_PUBLIC_KEY=
