VITE_API_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Optional: Sentry error monitoring. Leave blank to disable. Only used in prod builds.
VITE_SENTRY_DSN=

# Build-time only (source-map upload to Sentry). Not inlined into the bundle. Leave
# blank locally and in CI — the plugin is skipped and no source maps are emitted.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
