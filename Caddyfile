# Caddy config for serving the rent-control-web SPA on Railway.
# Binds to the port Railway injects via $PORT.

{
	# Railway terminates TLS at its edge; Caddy serves plain HTTP internally.
	auto_https off
	admin off
}

:{$PORT} {
	root * /srv
	encode gzip zstd

	# SPA history fallback: any unknown path serves index.html so client-side
	# routing (deep links, hard refresh) works instead of 404ing.
	try_files {path} /index.html
	file_server

	# --- Security headers (B4) ---
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"

		# Content-Security-Policy.
		# - style-src allows 'unsafe-inline' because Radix UI / Recharts inject
		#   inline styles for positioning; removing it breaks popovers/charts.
		# - connect-src includes the backend origin (set $BACKEND_ORIGIN in Railway,
		#   e.g. https://rent-control-backend.up.railway.app) plus Firebase endpoints.
		# - img-src allows blob: for local file previews (URL.createObjectURL) shown
		#   before upload, e.g. the property image and expense receipt thumbnails.
		# - frame-src allows the Firebase auth domain for popup/redirect sign-in.
		# - Paddle (script, style, frame buy./sandbox-buy., connect *.paddle.com) is for
		#   /pay, Paddle's default payment link. Paddle publishes no CSP list; these are
		#   the domains Paddle.js v2 loads from. A block shows in the browser console.
		# - RevenueCat (script sdk.revenuecat-static.com, connect api.revenuecat.com and
		#   e.revenue.cat, fonts from its CloudFront host) is the in-app checkout on
		#   /plans; these are the domains @revenuecat/purchases-js has hardcoded.
		# - RevenueCat (script sdk.revenuecat-static.com, connect api.revenuecat.com and
		#   e.revenue.cat, fonts from its CloudFront host) is the in-app checkout on
		#   /plans; the domains are the ones @revenuecat/purchases-js has hardcoded.
		# If something breaks on first deploy, temporarily rename this header to
		# "Content-Security-Policy-Report-Only" to diagnose without blocking.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://apis.google.com https://*.gstatic.com https://cdn.paddle.com https://sdk.revenuecat-static.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.paddle.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com https://da08ctfrofx1b.cloudfront.net; connect-src 'self' {$BACKEND_ORIGIN} https://*.googleapis.com https://*.gstatic.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebaseapp.com https://*.sentry.io https://*.paddle.com https://api.revenuecat.com https://e.revenue.cat; frame-src 'self' https://*.firebaseapp.com https://*.web.app https://apis.google.com https://accounts.google.com https://buy.paddle.com https://sandbox-buy.paddle.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

		# Hide the server banner.
		-Server
	}

	# --- Cache headers ---
	# Vite emits content-hashed files under /assets — safe to cache forever.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# index.html must always be revalidated so new deploys are picked up.
	@html path /index.html /
	header @html Cache-Control "no-cache"
}
